# Nusantara V1 — Lean Intelligence Engine environment
# Salin ke .env dan sesuaikan di masing-masing lingkungan (Windows / Linux).
# Tidak ada hardcode IP Windows, tidak ada Tailscale/Cloudflare, tidak dibuka ke publik.

# Backend (FastAPI) — hanya localhost untuk development & staging
NUSANTARA_HOST=127.0.0.1
NUSANTARA_PORT=8021

# Knowledge database (SQLite) — path relatif, portable Windows–Linux
NUSANTARA_KNOWLEDGE_DB=./data/knowledge/production_knowledge.db

# Ollama — lokal, environment-agnostik
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# Model intelligence (WP-05)
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_THREAD=4
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT=30

# Intent / routing thresholds (WP-01, WP-03)
INTENT_CONFIDENCE_THRESHOLD=0.35
RAG_TOP_K=5
EVIDENCE_MIN_SCORE=0.20

# Verifier (WP-06)
VERIFY_CITATION_REQUIRED=true
VERIFY_ALLOW_UNSUPPORTED=false

# Mode developer (metadata debugging) — matikan di produksi staging
DEVELOPER_MODE=false
