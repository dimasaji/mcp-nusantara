        now = datetime.utcnow()

        if format_type == "iso":
            result = now.isoformat()
        elif format_type == "human":
            result = now.strftime("%Y-%m-%d %H:%M:%S")
        elif format_type == "timestamp":
            result = int(now.timestamp())
        else:
