// wrangler.jsonc — Konfigurasi Cloudflare Workers Static Assets untuk Nusantara V1 Frontend
// Frontend berada di control-plane/, build output di dist/
{
  "$schema": "https://schemas.cloudflare.com/workers/platform/static-assets.json",
  "name": "nusantara-v1-frontend",
  "compatibility_date": "2026-11-27",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
