+def raw_proof(channel,corrupt=False,delay=0):
+    api = Windows()
+    handle = api.k.CreateFileW(channel.name,0xc0000000,0,None,3,0x120000,None)
+    assert handle != ctypes.c_void_p(-1).value
+    try:
+        mode = w.DWORD(2)
+        api.check(api.k.SetNamedPipeHandleState(handle,ctypes.byref(mode),None,None))
+        api.write(handle,{'protocol':'R2-A9-IPC-1','phase':'HELLO'})
+        challenge = api.read(handle)
+        if delay:
+            time.sleep(delay)
+        api.write(handle,{'phase':'PROOF','nonce':'0'*64 if corrupt else challenge['nonce'],'body':{'probe':'isolated'}})
+        return api.read(handle)
+    finally:
+        api.k.CloseHandle(handle)
+
