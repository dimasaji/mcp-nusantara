+def threaded_exchange(channel, body=None, *, pid=None, start=None, handler=None, client=None):
+    result = {}
+    pid = os.getpid() if pid is None else pid
+    start = channel.api.process_start(os.getpid()) if start is None else start
+    def run_client():
+        try:
+            result['client'] = client() if client else operator_exchange(channel.name, pid, start, body or {'probe':'isolated'})
+        except Exception as error:
+            result['client_error'] = error
+    thread = threading.Thread(target=run_client, daemon=True)
+    thread.start()
+    try:
+        channel.serve_once(handler or (lambda actor,data: {'observed':True}))
+    except Exception as error:
+        result['server_error'] = error
+        channel.api.k.DisconnectNamedPipe(channel.handle)
+    thread.join(timeout=5)
+    assert not thread.is_alive(), 'isolated client failed to terminate'
+    return result
 
