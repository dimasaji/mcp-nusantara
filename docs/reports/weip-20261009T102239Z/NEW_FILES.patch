+def source(**changes):
+    entry = SourceEntry("fixture", "Fixture Publisher", "Fixture Agency", "example.org",
+                        "https://example.org/allowed", (URL, FINAL), "WEB", "FIXTURE_ONLY",
+                        ("fixture-service",), min_interval_s=0)
+    return replace(entry, **changes)
+
